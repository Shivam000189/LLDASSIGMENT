# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection URI (e.g. MongoDB Atlas or self-hosted)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lld_assignment?retryWrites=true&w=majority

# CORS Allowed Origin(s) — comma-separated if multiple (e.g. https://my-frontend.vercel.app)
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Primary LLM: Free Google Gemini API Key (Get at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Secondary / Optional LLM: Anthropic Claude API Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
