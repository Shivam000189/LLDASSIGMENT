{
  "name": "lld-assignment-server",
  "version": "1.0.0",
  "description": "TypeScript Express server with MongoDB for LLD Assignment Practice Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
